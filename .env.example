# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional connection string for production MongoDB database.
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/talentbridge?retryWrites=true&w=majority
# If not provided, TalentBridge operates in built-in Persistent Demo Mode with auto-seeded data.
MONGODB_URI=""

# JWT_SECRET: Secret key for signing user authentication session tokens.
JWT_SECRET="talentbridge_super_secret_jwt_key_2026"

